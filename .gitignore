# ==============================================================================
# Full-Stack Internet Radio Streaming System - Git Ignore
# ==============================================================================

# 1. Environment & Secrets (SRS NFR-02, NFR-09)
# Keep database passwords and JWT secrets out of source control
.env
.env.local
.env.*.local
backend/.env
backend/.env.*.local
*.env

# Keep example configuration files tracked
!.env.example
!backend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
package-lock.json.backup

# 3. Local SQLite & Runtime Databases
backend/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Python Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

