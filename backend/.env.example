# ==============================================================================
# Full-Stack Internet Radio Streaming System
# Environment Configuration (.env.example)
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Local MySQL Database Configuration (Development)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password_here
DB_NAME=internet_radio

# ------------------------------------------------------------------------------
# 2. Production Database Configuration (Aiven MySQL on Render)
# Set NODE_ENV=production in your Render Dashboard.
# You can provide discrete values or a full DATABASE_URL URI.
# ------------------------------------------------------------------------------
AIVEN_DB_HOST=mysql-3ae389b6-internet-radio-station.c.aivencloud.com
AIVEN_DB_PORT=14717
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=your_aiven_password
AIVEN_DB_NAME=defaultdb
# Or full connection string:
DATABASE_URL=your_database_url_here

# ------------------------------------------------------------------------------
# Authentication & Session Security (SRS NFR-02, NFR-09)
# ------------------------------------------------------------------------------
JWT_SECRET=pulsecast_super_secure_jwt_signing_key_2026_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=pulsecast_cookie_secret_key_2026_replace_in_production

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# Add your deployed Vercel frontend URL here
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://vercel.com/rithvin/internet-radio-stream-frontend,http://localhost:5000,http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:5000
