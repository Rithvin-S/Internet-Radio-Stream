# ==============================================================================
# Full-Stack Internet Radio Streaming System
# Environment Configuration (.env.example)
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=internet_radio

# Authentication & Session Security (SRS NFR-02, NFR-09)
JWT_SECRET=pulsecast_super_secure_jwt_signing_key_2026_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=pulsecast_cookie_secret_key_2026_replace_in_production

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5000,http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:5000

