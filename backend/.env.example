# ==============================================================================
# Full-Stack Internet Radio Streaming System
# Environment Configuration (.env.example)
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration
# Set these in your hosting dashboard (Render) and local .env
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security (SRS NFR-02, NFR-09)
# ------------------------------------------------------------------------------
JWT_SECRET=pulsecast_super_secure_jwt_signing_key_2026_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=pulsecast_cookie_secret_key_2026_replace_in_production

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# Add your deployed Vercel frontend URL and local dev origins
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://vercel.com/rithvin/internet-radio-stream-frontend,http://localhost:5000,http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:5000
