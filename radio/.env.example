# ==============================================================================
# PulseCast EC2 Radio Production Environment Configuration Template
# Place in: /opt/pulsecast-radio/.env
# Protect:  chmod 600 /opt/pulsecast-radio/.env
# ==============================================================================

# 1. Icecast Streaming Credentials (DO NOT commit actual secrets)
# The source password MUST match what Liquidsoap uses to connect to Icecast
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
ICECAST_PASSWORD=
ICECAST_RELAY_PASSWORD=

# 2. Icecast Service Configuration
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_MOUNT=/pulsecast.mp3
ICECAST_HOSTNAME=pulsecast.duckdns.org
ICECAST_LOCATION=AWS-EC2-Ubuntu
ICECAST_ADMIN_EMAIL=admin@pulsecast.com

# 3. PulseCast Render Backend Integration
BACKEND_STREAMING_URL=https://internet-radio-stream.onrender.com/api/streaming/stations
RADIO_STREAMING_KEY=
RADIO_STATION_ID=7

# 4. Liquidsoap Audio Engine Settings
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234

# 5. Local Daemon Cache Settings
CACHE_DIR=/opt/pulsecast-radio/cache
CONTAINER_CACHE_DIR=/cache
CACHE_MAX_MB=500
POLL_INTERVAL_SECONDS=5
PRE_BUFFER_SECONDS=25

